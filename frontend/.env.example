# Public Supabase Auth configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: required to access Saathi household/membership tables from the trusted Next.js route.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
HOUSEHOLD_PIN_PEPPER=
HOUSEHOLD_CONTEXT_SIGNING_SECRET=
SAATHI_HOUSEHOLD_FEATURES_ENABLED=false

# Server-side only: FastAPI origin. Local development falls back to localhost
# only when NODE_ENV=development.
BACKEND_API_URL=http://localhost:8000

# Server-side only; must match backend API_AUTH_TOKEN. Never use NEXT_PUBLIC_*.
SAATHI_API_AUTH_TOKEN=

# Optional: authenticate the official React Bits Pro registry for licensed blocks.
REACTBITS_LICENSE_KEY=

# Production shared rate limiting (server-only; required in production).
# Provision an Upstash Redis REST database and set both values in the host secret manager.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Must name a single-IP header the hosting proxy is documented/configured to overwrite.
# SAATHI_TRUSTED_CLIENT_IP_HEADER=x-real-ip
