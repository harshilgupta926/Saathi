# Local development uses the FastAPI service directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel production: set BACKEND_API_URL to the deployed Saathi FastAPI origin
# (for example, your Render service URL). The browser calls same-origin /backend/*.
# BACKEND_API_URL=https://your-saathi-api.onrender.com

# Optional: authenticate the official React Bits Pro registry for licensed blocks.
REACTBITS_LICENSE_KEY=
